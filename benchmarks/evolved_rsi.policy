(rule (mcp_fw (mcp_call ?tool ?target ?has_path ?raw) ?k)
  (if (and (eq ?tool "fs_read") (not (str_starts_with ?target "/public/")))
    (blocked outside_public_root ?target)
    (if (eq ?tool "http_post")
    (blocked denied_http_post ?target)
    (if (and (eq ?tool "bash") (str_contains ?target "printenv"))
    (blocked denied_bash_printenv ?target)
    (if (and (eq ?tool "bash") (str_contains ?target "rm -rf"))
    (blocked denied_bash_rm_rf ?target)
    (ok (allowed ?tool ?target)))))))
